# 默认用 SQLite，零配置即可跑 demo / 测试
DB_BACKEND=sqlite
SQLITE_PATH=verify_lab.db

# ---- Telegram Bot ----
# 从 @BotFather 获取；只放本机 .env，不要提交到 git
BOT_TOKEN=
# 管理员的 Telegram 数字 ID（给 @userinfobot 发消息可查）
ADMIN_USER_ID=0
# 同时处理的更新数量；0 = 串行
BOT_CONCURRENT=32
# 轮询间隔；0 = 长轮询（推荐）
BOT_POLL_INTERVAL=0
# 启动时丢弃积压的旧消息
BOT_DROP_PENDING=1
# 仅测试/自建反代时使用，例如 http://127.0.0.1:8081/bot
TELEGRAM_BASE_URL=

# ---- 渲染 ----
# auto / playwright / pillow；服务器没装 Chromium 时用 pillow
RENDER_BACKEND=auto
OUTPUTS_DIR=outputs

# ---- 以下仅当 DB_BACKEND=mysql 时需要 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lab
MYSQL_PASSWORD=labpass
MYSQL_DATABASE=verify_lab

# docker-compose 起 MySQL 容器时用（root 密码只给容器初始化用）
MYSQL_ROOT_PASSWORD=rootpass
